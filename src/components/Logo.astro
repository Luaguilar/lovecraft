---
import { Image } from 'astro:assets';
import Emblem from '../assets/img/miskatonic-emblem.png';

import "../styles/logo.css";
---

<a class="link" href="/">
    <Image
        src={Emblem}
        width={100}
        height={100}
        loading="lazy"
        alt="Bosque al amanecer, con montañas de fondo"
        class="logo"
    />
</a>